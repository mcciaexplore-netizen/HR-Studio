# Node.js 24.x. Copy this file to .env.local if you need overrides.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=var/hrstudio.sqlite

# Optional local SQLite-compatible driver for testing: SQLITE_DRIVER=libsql
# Vercel uses a remote Turso database instead of DATABASE_PATH. Server secrets only.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# For an HTTPS deployment, set the exact public origin and close registration
# after creating the intended companies. Secure cookies default to true in production.
APP_URL=
REGISTRATION_OPEN=true
# Optional sample-only login buttons. First run npm run demo:populate.
DEMO_LOGIN_ENABLED=false
# Hosted startup only: create fictional samples on an empty database.
# Requires DEMO_LOGIN_ENABLED=true. See DEPLOYMENT.md for persistent hosting.
DEMO_BOOTSTRAP=false
# Local HTTP production smoke test only: COOKIE_SECURE=false
# Keep COOKIE_SECURE=true for an HTTPS deployment.

# Optional mail delivery. Nothing is sent if these are unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=

# Optional candidate evaluation; resumes are sent only on an explicit review action.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
